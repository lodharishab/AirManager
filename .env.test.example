# Copy to .env.test to run `npm test`. Never point this at production.
#
# tests/setup.ts connects to the database named here only to issue
# CREATE DATABASE / DROP DATABASE, then redirects every query to a
# throwaway database named airmanager_test_<pid>. The role therefore
# needs CREATEDB, and must NOT be a superuser:
#
#   CREATE ROLE airmanager_test LOGIN CREATEDB PASSWORD '<choose-one>';
#
# The suite refuses to run if NODE_ENV=production or if DATABASE_URL
# contains "prod"/"production".
NODE_ENV=test
DATABASE_URL=postgresql://airmanager_test:CHANGE_ME@127.0.0.1:5432/postgres
SESSION_SECRET=test-only-secret
